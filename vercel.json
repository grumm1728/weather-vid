{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -- --base /projects/weather/",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/projects/weather/", "destination": "/" },
    { "source": "/projects/weather/:path*", "destination": "/:path*" }
  ]
}
